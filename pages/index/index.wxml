<view class="container">
  <view class="header">
    <text class="title">活过今天</text>
    <text class="subtitle">在这个充满危险的世界里，你能活过今天吗？</text>
  </view>

  <view class="stats-card animate-pulse">
    <view class="stat-item">
      <text class="stat-value">{{ survivalDays }}</text>
      <text class="stat-label">已连续存活 (天)</text>
    </view>
  </view>

  <!-- 精品关卡 -->
  <view class="featured-label">
    <text class="featured-label-text">🔥 精品特选关卡 (大制作)</text>
  </view>

  <!-- 精品关卡一：深渊实验室 -->
  <view class="featured-card" bindtap="startEscapeRoom" style="margin-bottom: 24rpx;">
    <view class="featured-card-bg"></view>
    <view class="featured-card-content">
      <view class="featured-meta">
        <text class="featured-tag">🧪 密室逃脱</text>
        <text class="featured-diff">⚡ 高难度</text>
      </view>
      <text class="featured-title">深渊实验室：逃出生天</text>
      <text class="featured-desc">你在阴冷的废弃生化实验室中苏醒，四周大门紧闭。搜集线索、破解机关，找到唯一的生路！</text>
      <view class="featured-stats">
        <text class="featured-stat-item">🗺️ 25+ 节点</text>
        <text class="featured-stat-item">🔑 10种道具</text>
        <text class="featured-stat-item">🏆 3条结局</text>
      </view>
      <view class="featured-btn">
        <text class="featured-btn-text">立刻挑战 →</text>
      </view>
    </view>
  </view>

  <!-- 精品关卡二：丧尸写字楼 -->
  <view class="featured-card featured-zombie" bindtap="startZombieOffice">
    <view class="featured-card-bg-zombie"></view>
    <view class="featured-card-content">
      <view class="featured-meta">
        <text class="featured-tag tag-zombie">🧟 末日逃生</text>
        <text class="featured-diff diff-zombie">⚡ 超硬核</text>
      </view>
      <text class="featured-title">丧尸危机：逃出写字楼</text>
      <text class="featured-desc">下班前夕，公司大楼被丧尸沦陷！突破24层死线，收集神装与装甲车，开启完美大逃亡！</text>
      <view class="featured-stats">
        <text class="featured-stat-item">🗺️ 20个节点</text>
        <text class="featured-stat-item">🎒 10种道具</text>
        <text class="featured-stat-item">🏆 4条结局</text>
      </view>
      <view class="featured-btn btn-zombie">
        <text class="featured-btn-text">冲破重围 →</text>
      </view>
    </view>
  </view>

  <!-- 其他模式入口 -->
  <view class="divider-row">
    <view class="divider-line"></view>
    <text class="divider-text">或选择其他模式</text>
    <view class="divider-line"></view>
  </view>

  <view class="btn-container">
    <view class="btn btn-primary btn-glow" bindtap="startDailyGame">
      📅 今日生存挑战
    </view>
    <view class="btn btn-secondary" bindtap="startFreeGame">
      🎲 自由随机探索
    </view>
    <view class="btn btn-museum" bindtap="openMuseum">
      💀 死亡纪念馆
    </view>
  </view>
</view>