.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
  margin-bottom: 20rpx;
  text-shadow: 0 0 20rpx rgba(255, 107, 107, 0.5);
}

.subtitle {
  font-size: 28rpx;
  color: #a0a0a0;
  display: block;
}

.stats-card {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.1), rgba(238, 90, 90, 0.05));
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 107, 107, 0.2);
}

.stat-item {
  display: inline-block;
}

.stat-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
}

.stat-label {
  font-size: 28rpx;
  color: #a0a0a0;
  display: block;
  margin-top: 10rpx;
}

.btn-container {
  margin-bottom: 40rpx;
}

.btn {
  display: block;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.4);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.tips-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffe66d;
  display: block;
  margin-bottom: 20rpx;
}

.tips-content {
  font-size: 26rpx;
  color: #a0a0a0;
  display: block;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.tips-content:last-child {
  margin-bottom: 0;
}