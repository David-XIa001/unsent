.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
  margin-bottom: 20rpx;
  text-shadow: 0 0 20rpx rgba(255, 107, 107, 0.5);
}

.subtitle {
  font-size: 28rpx;
  color: #a0a0a0;
  display: block;
}

.stats-card {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.1), rgba(238, 90, 90, 0.05));
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 107, 107, 0.2);
}

.stat-item {
  display: inline-block;
}

.stat-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
}

.stat-label {
  font-size: 28rpx;
  color: #a0a0a0;
  display: block;
  margin-top: 10rpx;
}

/* ===== 精品关卡标签 ===== */
.featured-label {
  margin-bottom: 14rpx;
}

.featured-label-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff9f43;
  background: rgba(255, 159, 67, 0.12);
  border: 2rpx solid rgba(255, 159, 67, 0.25);
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
}

/* ===== 精品关卡卡片 ===== */
.featured-card {
  border-radius: 24rpx;
  margin-bottom: 36rpx;
  overflow: hidden;
  position: relative;
  border: 2rpx solid rgba(255, 159, 67, 0.3);
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.4), 0 0 30rpx rgba(255, 159, 67, 0.08);
  transition: all 0.25s ease;
}

.featured-card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}

/* 卡片背景：深色渐变，模拟实验室氛围 */
.featured-card-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(145deg, #0f1923 0%, #1a1035 50%, #0d1a1e 100%);
}

.featured-card-content {
  position: relative;
  padding: 36rpx 32rpx;
}

.featured-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.featured-tag {
  font-size: 22rpx;
  color: #4ecdc4;
  background: rgba(78, 205, 196, 0.1);
  border: 2rpx solid rgba(78, 205, 196, 0.25);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.featured-diff {
  font-size: 22rpx;
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.1);
  border: 2rpx solid rgba(255, 107, 107, 0.25);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.featured-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #f1f2f6;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.featured-desc {
  font-size: 26rpx;
  color: #a4b0be;
  display: block;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.featured-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.featured-stat-item {
  font-size: 22rpx;
  color: #636e72;
  background: rgba(255,255,255,0.04);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.06);
}

.featured-btn {
  background: linear-gradient(135deg, #ff9f43, #e67e22);
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 159, 67, 0.35);
}

.featured-btn-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ===== 分割线 ===== */
.divider-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  gap: 18rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.07);
}

.divider-text {
  font-size: 22rpx;
  color: #57606f;
  white-space: nowrap;
}

/* ===== 模式按钮区 ===== */
.btn-container {
  margin-bottom: 40rpx;
}



.btn {
  display: block;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.4);
}

.btn-glow {
  position: relative;
  overflow: hidden;
  animation: glow-pulse 2s infinite ease-in-out;
}

@keyframes glow-pulse {
  0%, 100% {
    box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.4);
  }
  50% {
    box-shadow: 0 8rpx 45rpx rgba(255, 107, 107, 0.8);
  }
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #e0e0e0;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
}

.btn-museum {
  background: linear-gradient(135deg, #4b5d67, #3c4f5e);
  color: #c4d7e0;
  border: 2rpx solid rgba(196, 215, 224, 0.3);
  box-shadow: 0 8rpx 30rpx rgba(75, 93, 103, 0.3);
}

.btn-museum:active {
  transform: scale(0.98);
  opacity: 0.9;
  background: linear-gradient(135deg, #3c4f5e, #2c3e4c);
}

.animate-pulse {
  animation: pulse-border 3s infinite ease-in-out;
}

@keyframes pulse-border {
  0%, 100% {
    border-color: rgba(255, 107, 107, 0.2);
    box-shadow: 0 0 10rpx rgba(255, 107, 107, 0.05);
  }
  50% {
    border-color: rgba(255, 107, 107, 0.4);
    box-shadow: 0 0 25rpx rgba(255, 107, 107, 0.2);
  }
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.tips-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffe66d;
  display: block;
  margin-bottom: 20rpx;
}

.tips-content {
  font-size: 26rpx;
  color: #a0a0a0;
  display: block;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.tips-content:last-child {
  margin-bottom: 0;
}

/* ===== 丧尸危机专属精品卡片样式 ===== */
.featured-zombie {
  border: 2rpx solid rgba(155, 89, 182, 0.45);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.4), 0 0 35rpx rgba(155, 89, 182, 0.15);
}

.featured-card-bg-zombie {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(145deg, #0b071e 0%, #1d0f36 50%, #0d1e13 100%);
}

.tag-zombie {
  color: #c56cf0;
  background: rgba(197, 108, 240, 0.12);
  border: 2rpx solid rgba(197, 108, 240, 0.3);
}

.diff-zombie {
  color: #ff3f34;
  background: rgba(255, 63, 52, 0.15);
  border: 2rpx solid rgba(255, 63, 52, 0.35);
  animation: zombie-blink 1.5s infinite ease-in-out;
}

.btn-zombie {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  box-shadow: 0 6rpx 22rpx rgba(142, 68, 173, 0.45);
  animation: btn-zombie-pulse 2s infinite ease-in-out;
}

.btn-zombie:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(142, 68, 173, 0.3);
}

@keyframes zombie-blink {
  0%, 100% {
    opacity: 1;
    box-shadow: 0 0 10rpx rgba(255, 63, 52, 0.2);
  }
  50% {
    opacity: 0.7;
    box-shadow: 0 0 20rpx rgba(255, 63, 52, 0.5);
  }
}

@keyframes btn-zombie-pulse {
  0%, 100% {
    box-shadow: 0 6rpx 22rpx rgba(142, 68, 173, 0.45);
  }
  50% {
    box-shadow: 0 6rpx 35rpx rgba(142, 68, 173, 0.75);
  }
}