<view class="container">
  <view class="game-container">
    <view class="status-bar">
      <text class="status-text">{{ modeText }} • 第 {{ day }} 天</text>
      <view class="hp-bar" wx:if="{{ !showCharacterSelect }}">
        <text class="hp-heart" wx:for="{{ [0, 1, 2] }}" wx:key="*this">{{ index < hp ? '💖' : '💔' }}</text>
      </view>
    </view>

    <!-- 背包栏：当前持有道具（仅有道具时才显示） -->
    <view class="inventory-bar" wx:if="{{ currentItems.length > 0 && !over && !showOutcome }}">
      <text class="inventory-label">🎒 背包</text>
      <view class="inventory-items">
        <view class="item-chip" wx:for="{{ currentItems }}" wx:key="name">
          <text class="item-emoji">{{ item.emoji }}</text>
          <text class="item-name">{{ item.name }}</text>
        </view>
      </view>
    </view>
    
    <!-- 剧情文本区 -->
    <view class="scene-card" wx:if="{{ !over && !showOutcome }}" bindtap="skipTyping">
      <view class="scene-content">
        <rich-text class="story-text" nodes="{{ typedStory }}" wx:if="{{ typingFinished }}"></rich-text>
        <text class="story-text" wx:else>{{ typedStory }}<text class="cursor-blink">_</text></text>
      </view>
      <text class="scene-hint" wx:if="{{ !typingFinished }}">⚡ 轻触任意区域跳过文字动画</text>
      <text class="scene-hint" wx:else>👀 仔细观察剧情中的金黄色高亮线索，做出最优抉择...</text>
    </view>
    
    <!-- 选项区 -->
    <view class="choices-card {{ typingFinished ? 'fade-in' : 'hidden-choices' }}" wx:if="{{ !over && !showOutcome && choices.length > 0 }}">
      <text class="choices-title">你的选择</text>
      <view 
        class="choice-item {{ item.riskClass }}" 
        wx:for="{{ choices }}" 
        wx:key="id"
        data-id="{{ item.id }}"
        bindtap="onPick"
      >
        <view class="choice-header">
          <text class="choice-text">{{ item.txt }}</text>
          <text class="choice-risk">{{ item.risk }}</text>
        </view>
        <text class="choice-clue" wx:if="{{ item.clue }}">{{ item.clueTip }}</text>
      </view>
    </view>

    <!-- ★ 选择结果反馈屏（存活过渡层） -->
    <view class="outcome-overlay" wx:if="{{ showOutcome }}">
      <view class="outcome-card">
        <view class="outcome-card-glow"></view>

        <!-- 存活标志 -->
        <view class="outcome-header">
          <text class="outcome-icon">💚</text>
          <text class="outcome-title">化险为夷</text>
        </view>

        <!-- 你选择了什么 -->
        <view class="outcome-choice-row">
          <text class="outcome-choice-label">你的选择</text>
          <text class="outcome-choice-text">{{ outcomeChoice }}</text>
        </view>

        <!-- 险情复盘叙事 -->
        <view class="outcome-near-miss">
          <text class="outcome-near-miss-text">{{ outcomeNearMiss }}</text>
        </view>

        <!-- 本次获得道具（有道具才显示） -->
        <view class="outcome-gained" wx:if="{{ outcomeGained.length > 0 }}">
          <text class="outcome-gained-title">✨ 获得道具</text>
          <view class="gained-chips">
            <view class="gained-chip" wx:for="{{ outcomeGained }}" wx:key="name">
              <text class="gained-emoji">{{ item.emoji }}</text>
              <text class="gained-name">{{ item.name }}</text>
            </view>
          </view>
        </view>

        <!-- 当前全部背包 -->
        <view class="outcome-bag" wx:if="{{ currentItems.length > 0 }}">
          <text class="outcome-bag-title">🎒 当前持有</text>
          <view class="bag-chips">
            <view class="bag-chip" wx:for="{{ currentItems }}" wx:key="name">
              <text class="bag-chip-emoji">{{ item.emoji }}</text>
              <text class="bag-chip-name">{{ item.name }}</text>
            </view>
          </view>
        </view>

        <!-- 继续按钮 -->
        <view class="btn btn-continue" bindtap="continueGame">
          继续前行 →
        </view>
      </view>
    </view>
    
    <!-- 死亡/通关结算屏 -->
    <view class="result-overlay {{ win ? 'success-overlay' : 'failure-overlay' }}" wx:if="{{ over }}">
      <view class="result-card {{ win ? 'success' : 'failure' }}">
        <view class="result-card-glow"></view>
        <text class="result-icon">{{ win ? '🎉' : '💀' }}</text>
        <text class="result-title">{{ win ? '生存成功' : '不幸惨死' }}</text>
        <text class="result-message">{{ msg }}</text>
        <view class="result-stats">
          <text class="result-stat">已连续存活: {{ saved }} 天</text>
        </view>

        <!-- 📣 微信分享裂变复活按钮 -->
        <button class="btn btn-share-revive" open-type="share" bindtap="reviveGame" wx:if="{{ !win && !revived }}">
          📣 召唤救援 (分享群免费复活)
        </button>

        <view class="btn btn-primary" bindtap="restart">
          {{ win ? '继续挑战' : '重塑命运' }}
        </view>
        <view class="btn btn-secondary" bindtap="goHome">
          返回营地
        </view>
      </view>
    </view>

    <!-- ★ 扣血生命垂危（Dying）过渡屏 -->
    <view class="dying-overlay" wx:if="{{ showDying }}">
      <view class="dying-card">
        <view class="dying-card-glow"></view>
        <view class="dying-header">
          <text class="dying-icon">⚠️</text>
          <text class="dying-title">死里逃生</text>
        </view>
        
        <view class="dying-choice-row">
          <text class="dying-choice-label">危险决策</text>
          <text class="dying-choice-text">{{ dyingChoiceText }}</text>
        </view>

        <view class="dying-narrative">
          <text class="dying-narrative-text">{{ dyingNarrative }}</text>
        </view>

        <!-- 当前剩余血量 -->
        <view class="dying-hp-status">
          <text class="dying-hp-label">当前剩余生命值</text>
          <view class="dying-hp-hearts">
            <text class="dying-hp-heart" wx:for="{{ [0, 1, 2] }}" wx:key="*this">{{ index < hp ? '💖' : '💔' }}</text>
          </view>
        </view>

        <view class="btn btn-dying-continue" bindtap="continueAfterDying">
          捂着伤口前行 →
        </view>
      </view>
    </view>

    <!-- ★ 职业角色选择面板 -->
    <view class="character-select-overlay" wx:if="{{ showCharacterSelect }}">
      <view class="char-select-card animate-scale-up">
        <view class="char-select-glow"></view>
        <text class="char-select-title">选择求生职业</text>
        <text class="char-select-subtitle">各职业拥有独特的属性与天赋，深刻影响各项行动生还率。请挑选您的身份：</text>
        
        <scroll-view class="char-list" scroll-y="true">
          <view 
            class="char-option-item {{ selectedCharIndex === index ? 'active' : '' }}" 
            wx:for="{{ availableCharacters }}" 
            wx:key="id"
            data-index="{{ index }}"
            bindtap="selectCharacter"
          >
            <view class="char-option-card-glow" wx:if="{{ selectedCharIndex === index }}"></view>
            <view class="char-option-header">
              <view class="char-name-row">
                <text class="char-option-name">{{ item.name }}</text>
                <text class="char-option-badge" wx:if="{{ selectedCharIndex === index }}">已选定</text>
              </view>
              <text class="char-option-desc">{{ item.description }}</text>
            </view>
            <!-- 展示角色的特质/天赋 -->
            <view class="char-traits-row">
              <view class="trait-tag {{ trait.type }}" wx:for="{{ item.traits }}" wx:for-item="trait" wx:key="name">
                <text class="trait-icon">{{ trait.type === 'buff' ? '🟢' : '🔴' }}</text>
                <text class="trait-tag-name">{{ trait.name }}</text>
                <text class="trait-tag-effect">{{ trait.description }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        
        <view class="btn btn-confirm-char" bindtap="confirmCharacter">
          以该身份步入深渊 →
        </view>
      </view>
    </view>
  </view>
</view>