.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 20rpx;
  box-sizing: border-box;
}

.game-container {
  max-width: 750rpx;
  margin: 0 auto;
}

.status-bar {
  text-align: center;
  margin-bottom: 30rpx;
}

.status-text {
  font-size: 28rpx;
  color: #ffe66d;
  background: rgba(255, 230, 109, 0.1);
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
}

/* ===== 背包栏 ===== */
.inventory-bar {
  display: flex;
  align-items: center;
  background: rgba(78, 205, 196, 0.06);
  border: 2rpx solid rgba(78, 205, 196, 0.18);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.inventory-label {
  font-size: 24rpx;
  color: #4ecdc4;
  margin-right: 18rpx;
  font-weight: bold;
  white-space: nowrap;
}

.inventory-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.item-chip {
  display: flex;
  align-items: center;
  background: rgba(78, 205, 196, 0.1);
  border: 2rpx solid rgba(78, 205, 196, 0.25);
  border-radius: 30rpx;
  padding: 6rpx 18rpx;
  gap: 8rpx;
}

.item-emoji {
  font-size: 26rpx;
}

.item-name {
  font-size: 22rpx;
  color: #4ecdc4;
}

/* ===== 选择结果反馈屏（存活过渡层） ===== */
.outcome-overlay {
  animation: outcome-pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.2) forwards;
}

@keyframes outcome-pop {
  0%  { opacity: 0; transform: scale(0.92) translateY(20rpx); }
  100%{ opacity: 1; transform: scale(1)    translateY(0); }
}

.outcome-card {
  background: linear-gradient(160deg, #0d1f1e 0%, #111827 100%);
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  border: 2rpx solid rgba(78, 205, 196, 0.3);
  box-shadow: 0 0 40rpx rgba(78, 205, 196, 0.12), 0 15rpx 40rpx rgba(0,0,0,0.4);
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.outcome-card-glow {
  position: absolute;
  top: -60%;
  left: -30%;
  width: 160%;
  height: 160%;
  background: radial-gradient(ellipse, rgba(78, 205, 196, 0.06) 0%, transparent 65%);
  pointer-events: none;
}

.outcome-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.outcome-icon {
  font-size: 56rpx;
}

.outcome-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #4ecdc4;
  text-shadow: 0 0 20rpx rgba(78, 205, 196, 0.4);
  letter-spacing: 2rpx;
}

/* 选择复盘 */
.outcome-choice-row {
  background: rgba(255, 255, 255, 0.03);
  border-left: 6rpx solid rgba(255, 230, 109, 0.5);
  border-radius: 0 12rpx 12rpx 0;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
}

.outcome-choice-label {
  font-size: 22rpx;
  color: #ffe66d;
  display: block;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.outcome-choice-text {
  font-size: 28rpx;
  color: #e0e0e0;
  display: block;
  line-height: 1.5;
}

/* 险情复盘叙事 */
.outcome-near-miss {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.05);
}

.outcome-near-miss-text {
  font-size: 28rpx;
  color: #b2bec3;
  line-height: 1.85;
  display: block;
}

/* 获得道具 */
.outcome-gained {
  margin-bottom: 24rpx;
}

.outcome-gained-title {
  font-size: 24rpx;
  color: #ffe66d;
  font-weight: bold;
  display: block;
  margin-bottom: 14rpx;
}

.gained-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.gained-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, rgba(255, 230, 109, 0.12), rgba(255, 230, 109, 0.06));
  border: 2rpx solid rgba(255, 230, 109, 0.35);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  animation: gained-bounce 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.4) forwards;
}

@keyframes gained-bounce {
  0%  { transform: scale(0); opacity: 0; }
  80% { transform: scale(1.08); opacity: 1; }
  100%{ transform: scale(1); opacity: 1; }
}

.gained-emoji {
  font-size: 32rpx;
}

.gained-name {
  font-size: 26rpx;
  color: #ffe66d;
  font-weight: bold;
}

/* 当前背包 */
.outcome-bag {
  margin-bottom: 36rpx;
}

.outcome-bag-title {
  font-size: 22rpx;
  color: #4ecdc4;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.bag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.bag-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(78, 205, 196, 0.08);
  border: 2rpx solid rgba(78, 205, 196, 0.2);
  border-radius: 30rpx;
  padding: 8rpx 18rpx;
}

.bag-chip-emoji {
  font-size: 26rpx;
}

.bag-chip-name {
  font-size: 22rpx;
  color: #4ecdc4;
}

/* 继续按钮 */
.btn-continue {
  background: linear-gradient(135deg, #4ecdc4, #44b0a8);
  color: #0d1f1e;
  font-weight: 800;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 25rpx rgba(78, 205, 196, 0.35);
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.btn-continue:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.2);
}



.scene-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.scene-header {
  margin-bottom: 20rpx;
}

.scene-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.scene-content {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 15rpx;
  padding: 25rpx;
}

.story-text {
  font-size: 30rpx;
  color: #e0e0e0;
  line-height: 1.8;
}

.scene-hint {
  font-size: 22rpx;
  color: rgba(255, 230, 109, 0.5);
  display: block;
  margin-top: 20rpx;
  text-align: center;
}

.choices-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.choices-title {
  font-size: 28rpx;
  color: #ffe66d;
  margin-bottom: 20rpx;
  display: block;
}

.choice-item {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 20rpx;
  transition: all 0.25s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.choice-item:active {
  background: rgba(255, 107, 107, 0.12);
  border-color: rgba(255, 107, 107, 0.4);
  box-shadow: 0 0 15rpx rgba(255, 107, 107, 0.2);
}

.choice-item:last-child {
  margin-bottom: 0;
}

/* 选项头部排版 */
.choice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.choice-text {
  font-size: 30rpx;
  color: #f1f2f6;
  font-weight: 500;
  flex: 1;
}

.choice-risk {
  font-size: 24rpx;
  color: #a4b0be;
  background: rgba(255, 255, 255, 0.05);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
  font-weight: bold;
}

/* 五档氛围警告选项样式 */
.choice-item.risk-low {
  border-color: rgba(78, 205, 196, 0.15);
}
.choice-item.risk-low .choice-risk {
  color: #4ecdc4;
  background: rgba(78, 205, 196, 0.08);
}
.choice-item.risk-low:active {
  background: rgba(78, 205, 196, 0.08);
  border-color: rgba(78, 205, 196, 0.4);
  box-shadow: 0 0 15rpx rgba(78, 205, 196, 0.2);
}

.choice-item.risk-mid {
  border-color: rgba(255, 230, 109, 0.15);
}
.choice-item.risk-mid .choice-risk {
  color: #ffe66d;
  background: rgba(255, 230, 109, 0.08);
}
.choice-item.risk-mid:active {
  background: rgba(255, 230, 109, 0.08);
  border-color: rgba(255, 230, 109, 0.4);
  box-shadow: 0 0 15rpx rgba(255, 230, 109, 0.2);
}

.choice-item.risk-high {
  border-color: rgba(255, 165, 0, 0.18);
}
.choice-item.risk-high .choice-risk {
  color: #ffa500;
  background: rgba(255, 165, 0, 0.08);
}
.choice-item.risk-high:active {
  background: rgba(255, 165, 0, 0.08);
  border-color: rgba(255, 165, 0, 0.4);
  box-shadow: 0 0 15rpx rgba(255, 165, 0, 0.2);
}

.choice-item.risk-extreme {
  border-color: rgba(255, 107, 107, 0.22);
}
.choice-item.risk-extreme .choice-risk {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.08);
  text-shadow: 0 0 8px rgba(255, 107, 107, 0.4);
}
.choice-item.risk-extreme:active {
  background: rgba(255, 107, 107, 0.08);
  border-color: rgba(255, 107, 107, 0.5);
  box-shadow: 0 0 15rpx rgba(255, 107, 107, 0.3);
}

.choice-item.risk-extreme-shake {
  border-color: rgba(255, 71, 87, 0.3);
  animation: option-shake 0.8s infinite alternate ease-in-out;
}
.choice-item.risk-extreme-shake .choice-risk {
  color: #ff4757;
  background: rgba(255, 71, 87, 0.15);
  text-shadow: 0 0 10px rgba(255, 71, 87, 0.5);
}
.choice-item.risk-extreme-shake:active {
  background: rgba(255, 71, 87, 0.12);
  border-color: rgba(255, 71, 87, 0.6);
  box-shadow: 0 0 15rpx rgba(255, 71, 87, 0.4);
}

@keyframes option-shake {
  0% { transform: translateX(0); }
  25% { transform: translateX(-1px) rotate(-0.2deg); }
  75% { transform: translateX(1px) rotate(0.2deg); }
  100% { transform: translateX(0); }
}

.choice-clue {
  font-size: 22rpx;
  color: #ffe66d;
  margin-top: 12rpx;
  display: block;
}

/* 打字机光标闪烁 */
.cursor-blink {
  color: #ffe66d;
  font-weight: bold;
  animation: blink 0.8s infinite;
  margin-left: 6rpx;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 选项列表过渡动画 */
.hidden-choices {
  opacity: 0;
  transform: translateY(20rpx);
  pointer-events: none;
  transition: all 0.5s ease;
  height: 0;
  overflow: hidden;
  padding: 0 30rpx !important;
  margin: 0 !important;
}

.fade-in {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 全屏警示遮罩及动效 */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
  transition: background-color 0.5s ease;
}

.success-overlay {
  background: rgba(10, 11, 16, 0.85);
  animation: success-pulse 4s infinite alternate;
}

.failure-overlay {
  background: rgba(20, 5, 5, 0.9);
  animation: death-flash 3s infinite alternate;
}

@keyframes death-flash {
  0% { background: rgba(20, 5, 5, 0.88); }
  50% { background: rgba(45, 8, 8, 0.93); }
  100% { background: rgba(20, 5, 5, 0.88); }
}

@keyframes success-pulse {
  0% { background: rgba(10, 11, 16, 0.85); }
  100% { background: rgba(10, 24, 20, 0.88); }
}

/* 结算卡片立体霓虹流光背景 */
.result-card {
  background: #11121b;
  border-radius: 30rpx;
  padding: 60rpx 50rpx;
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  border: 4rpx solid;
  position: relative;
  overflow: hidden;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
  animation: pop-up 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.2);
}

@keyframes pop-up {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.result-card-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%);
  pointer-events: none;
}

.result-card.success .result-card-glow {
  background: radial-gradient(circle, rgba(78,205,196,0.06) 0%, transparent 60%);
}

.result-card.failure .result-card-glow {
  background: radial-gradient(circle, rgba(255,107,107,0.06) 0%, transparent 60%);
}

.result-card.success {
  box-shadow: 0 0 40rpx rgba(78, 205, 196, 0.25);
  border-color: #4ecdc4;
}

.result-card.failure {
  box-shadow: 0 0 40rpx rgba(255, 107, 107, 0.25);
  border-color: #ff6b6b;
}

.result-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.result-card.success .result-title {
  color: #4ecdc4;
  text-shadow: 0 0 15rpx rgba(78, 205, 196, 0.4);
}

.result-card.failure .result-title {
  color: #ff6b6b;
  text-shadow: 0 0 15rpx rgba(255, 107, 107, 0.4);
}

.result-message {
  font-size: 28rpx;
  color: #a4b0be;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.result-stats {
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.02);
  padding: 16rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.result-stat {
  font-size: 28rpx;
  color: #ffe66d;
  font-weight: 600;
}

.btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.btn:last-child {
  margin-bottom: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.95;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 107, 0.2);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.06);
  color: #e0e0e0;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.97);
}

/* ==========================================
   ★ 职业角色选择面板样式
   ========================================== */
.character-select-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(15px); /* 高级毛玻璃背景 */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 120;
  padding: 40rpx;
}

.char-select-card {
  background: linear-gradient(180deg, #161722, #0f1016);
  border-radius: 36rpx;
  padding: 50rpx 40rpx;
  width: 100%;
  max-width: 650rpx;
  height: 85vh;
  display: flex;
  flex-direction: column;
  border: 2px solid rgba(255, 255, 255, 0.08);
  position: relative;
  overflow: hidden;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
}

.char-select-glow {
  position: absolute;
  top: -10%;
  right: -10%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.1) 0%, transparent 80%);
  pointer-events: none;
}

.char-select-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  text-align: center;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 0 15rpx rgba(255, 255, 255, 0.2);
}

.char-select-subtitle {
  font-size: 24rpx;
  color: #a4b0be;
  text-align: center;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.char-list {
  flex: 1;
  overflow-y: hidden;
  margin-bottom: 30rpx;
}

.char-option-item {
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.char-option-item:active {
  background: rgba(255, 255, 255, 0.06);
}

.char-option-item.active {
  background: rgba(78, 205, 196, 0.05);
  border-color: rgba(78, 205, 196, 0.4);
  box-shadow: 0 0 20rpx rgba(78, 205, 196, 0.15);
}

.char-option-card-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: #4ecdc4;
  box-shadow: 0 0 15rpx rgba(78, 205, 196, 0.6);
}

.char-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.char-option-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.char-option-badge {
  font-size: 20rpx;
  color: #0d1f1e;
  background: #4ecdc4;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
  letter-spacing: 1px;
}

.char-option-desc {
  font-size: 24rpx;
  color: #8892b0;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.char-traits-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.trait-tag {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1px solid transparent;
}

.trait-tag.buff {
  background: rgba(78, 205, 196, 0.06);
  border-color: rgba(78, 205, 196, 0.15);
}

.trait-tag.debuff {
  background: rgba(255, 107, 107, 0.05);
  border-color: rgba(255, 107, 107, 0.12);
}

.trait-icon {
  font-size: 22rpx;
  line-height: 1;
  margin-top: 4rpx;
}

.trait-tag-name {
  font-size: 22rpx;
  font-weight: bold;
}

.trait-tag.buff .trait-tag-name {
  color: #4ecdc4;
}

.trait-tag.debuff .trait-tag-name {
  color: #ff6b6b;
}

.trait-tag-effect {
  font-size: 20rpx;
  color: #a4b0be;
  flex: 1;
}

.btn-confirm-char {
  background: linear-gradient(135deg, #4ecdc4, #36b3a8);
  color: #0d1f1e;
  font-weight: 800;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 25rpx rgba(78, 205, 196, 0.3);
  margin-bottom: 0;
}

.btn-confirm-char:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.15);
}

/* ==========================================
   ★ 顶部状态栏爱心血量样式
   ========================================== */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.hp-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.04);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.hp-heart {
  font-size: 26rpx;
  display: inline-block;
  animation: heart-pulse 2s infinite alternate ease-in-out;
}

@keyframes heart-pulse {
  0% { transform: scale(1); filter: drop-shadow(0 0 2px rgba(255,107,107,0.3)); }
  100% { transform: scale(1.08); filter: drop-shadow(0 0 6px rgba(255,107,107,0.6)); }
}

/* ==========================================
   ★ Dying 濒死过渡屏全套样式
   ========================================== */
.dying-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 3, 3, 0.9);
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 110;
  padding: 40rpx;
  animation: dying-flash 2.5s infinite alternate ease-in-out;
}

@keyframes dying-flash {
  0% { box-shadow: inset 0 0 40rpx rgba(255, 71, 87, 0.25); }
  50% { box-shadow: inset 0 0 100rpx rgba(255, 71, 87, 0.5); }
  100% { box-shadow: inset 0 0 40rpx rgba(255, 71, 87, 0.25); }
}

.dying-card {
  background: linear-gradient(180deg, #1d0a0b, #0f0505);
  border-radius: 36rpx;
  padding: 50rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  border: 2px solid rgba(255, 71, 87, 0.3);
  box-shadow: 0 20px 50px rgba(255, 71, 87, 0.2);
  text-align: center;
  position: relative;
  overflow: hidden;
  animation: pop-up 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.25);
}

.dying-card-glow {
  position: absolute;
  top: -30%;
  left: -30%;
  width: 160%;
  height: 160%;
  background: radial-gradient(circle, rgba(255, 71, 87, 0.08) 0%, transparent 60%);
  pointer-events: none;
}

.dying-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 30rpx;
}

.dying-icon {
  font-size: 80rpx;
  animation: heartbeat-vibrate 0.6s infinite alternate ease-in-out;
}

@keyframes heartbeat-vibrate {
  0% { transform: scale(1); }
  30% { transform: scale(1.15); }
  60% { transform: scale(1.05); }
  100% { transform: scale(1.2); }
}

.dying-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ff4757;
  letter-spacing: 2px;
  text-shadow: 0 0 15rpx rgba(255, 71, 87, 0.5);
}

.dying-choice-row {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: left;
}

.dying-choice-label {
  font-size: 20rpx;
  color: rgba(255, 71, 87, 0.6);
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.dying-choice-text {
  font-size: 26rpx;
  color: #f1f2f6;
  line-height: 1.4;
  display: block;
}

.dying-narrative {
  background: rgba(255, 71, 87, 0.04);
  border: 1px solid rgba(255, 71, 87, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  text-align: left;
}

.dying-narrative-text {
  font-size: 28rpx;
  color: #ffb8b8;
  line-height: 1.7;
}

.dying-hp-status {
  margin-bottom: 40rpx;
}

.dying-hp-label {
  font-size: 22rpx;
  color: #a4b0be;
  display: block;
  margin-bottom: 12rpx;
}

.dying-hp-hearts {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dying-hp-heart {
  font-size: 40rpx;
}

.btn-dying-continue {
  background: linear-gradient(135deg, #ff4757, #ee3543);
  color: #fff;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 71, 87, 0.35);
  margin-bottom: 0;
}

.btn-dying-continue:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 10rpx rgba(255, 71, 87, 0.2);
}

/* ==========================================
   ★ 📣 微信分享裂变复活按钮样式
   ========================================== */
.btn-share-revive {
  background: linear-gradient(135deg, #2ed573, #26af5f) !important;
  color: #071f11 !important;
  font-weight: 800 !important;
  box-shadow: 0 8rpx 25rpx rgba(46, 213, 115, 0.35) !important;
  border: none !important;
  border-radius: 44rpx !important;
  animation: revive-vibrate 1.5s infinite ease-in-out;
  padding: 0 !important;
}

@keyframes revive-vibrate {
  0% { transform: scale(1); }
  2% { transform: scale(1.04) rotate(-1deg); }
  4% { transform: scale(1.04) rotate(1deg); }
  6% { transform: scale(1.04) rotate(-1deg); }
  8% { transform: scale(1.04) rotate(1deg); }
  10% { transform: scale(1); }
  100% { transform: scale(1); }
}

.btn-share-revive::after {
  border: none !important;
}

.btn-share-revive:active {
  transform: scale(0.97) !important;
  box-shadow: 0 4rpx 12rpx rgba(46, 213, 115, 0.2) !important;
}