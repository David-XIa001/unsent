<view class="container">
  <view class="museum-container">
    <view class="header">
      <text class="title">💀 死亡纪念馆</text>
      <text class="subtitle">记录你在命运交叉口踩过的所有深坑</text>
    </view>

    <!-- 顶部总览数据面板 -->
    <view class="stats-panel card animate-pulse">
      <view class="progress-container">
        <view class="progress-circle">
          <text class="percentage-val">{{ percentage }}%</text>
          <text class="percentage-lbl">死亡达成率</text>
        </view>
        <view class="summary-stats">
          <view class="stat-row">
            <text class="stat-lbl">全收集死因：</text>
            <text class="stat-val text-warning">{{ unlockedCauses }} / {{ totalCauses }}</text>
          </view>
          <view class="stat-row">
            <text class="stat-lbl">总死亡次数：</text>
            <text class="stat-val text-danger">{{ totalDeaths }} 次</text>
          </view>
          <view class="stat-tip">死法收集得越多，说明你探索得越深...</view>
        </view>
      </view>
    </view>

    <!-- 图鉴列表区 -->
    <view class="list-section">
      <text class="section-title">🕯️ 已解锁的命运图鉴</text>
      
      <view class="cause-grid">
        <view 
          class="cause-card {{ item.unlocked ? 'unlocked-card' : 'locked-card' }}" 
          wx:for="{{ causesList }}" 
          wx:key="cause"
        >
          <!-- 解锁状态 -->
          <block wx:if="{{ item.unlocked }}">
            <view class="card-header">
              <text class="card-badge text-danger">☠️ 已达成 {{ item.count }} 次</text>
              <view class="card-icon">💀</view>
            </view>
            <view class="card-body">
              <text class="card-cause">{{ item.cause }}</text>
              <text class="card-comment">{{ item.comment }}</text>
            </view>
          </block>

          <!-- 未解锁状态 -->
          <block wx:else>
            <view class="card-header">
              <text class="card-badge text-muted">🔒 未解锁</text>
              <view class="card-icon locked-icon">?</view>
            </view>
            <view class="card-body">
              <text class="card-cause locked-cause">？？？？？？？？</text>
              <text class="card-comment locked-comment">此致命支路尚未被你触发。在自由探索中选择更大胆、更危险的方向去解开它吧。</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 底部功能按钮 -->
    <view class="action-buttons">
      <view class="btn btn-secondary" bindtap="goBack">返回营地</view>
      <view class="btn btn-reset" bindtap="resetMuseum">⚠️ 重塑记忆</view>
    </view>
  </view>
</view>
