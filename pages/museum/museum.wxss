.container {
  min-height: 100vh;
  background: #0f0f1a;
  padding: 30rpx 20rpx;
  box-sizing: border-box;
}

.museum-container {
  max-width: 750rpx;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
  margin-bottom: 12rpx;
  text-shadow: 0 0 20rpx rgba(255, 107, 107, 0.4);
}

.subtitle {
  font-size: 26rpx;
  color: #8b8f99;
  display: block;
}

/* 顶部总览卡片（毛玻璃与发光特效） */
.stats-panel {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.08) 0%, rgba(15, 15, 26, 0.6) 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid rgba(255, 107, 107, 0.2);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.4);
}

.progress-container {
  display: flex;
  align-items: center;
}

/* 环形进度条的替代布局：精美现代数字圆环 */
.progress-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 107, 107, 0.15);
  border-top-color: #ff6b6b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20rpx rgba(255, 107, 107, 0.1);
  margin-right: 40rpx;
  background: rgba(0, 0, 0, 0.3);
}

.percentage-val {
  font-size: 46rpx;
  font-weight: 800;
  color: #ff6b6b;
  text-shadow: 0 0 10rpx rgba(255, 107, 107, 0.3);
}

.percentage-lbl {
  font-size: 18rpx;
  color: #8b8f99;
  margin-top: 4rpx;
}

.summary-stats {
  flex: 1;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.stat-lbl {
  font-size: 26rpx;
  color: #a4b0be;
}

.stat-val {
  font-size: 28rpx;
  font-weight: 700;
}

.stat-tip {
  font-size: 20rpx;
  color: #636e72;
  margin-top: 15rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
  padding-top: 10rpx;
}

/* 列表区 */
.list-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffe66d;
  display: block;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #ffe66d;
}

.cause-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 卡片样式（毛玻璃背景） */
.cause-card {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.unlocked-card {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  border-color: rgba(255, 107, 107, 0.15);
}

.locked-card {
  background: rgba(255, 255, 255, 0.01);
  border-color: rgba(255, 255, 255, 0.02);
  opacity: 0.7;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-badge {
  font-size: 22rpx;
  font-weight: bold;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.card-badge.text-danger {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.12);
  border: 2rpx solid rgba(255, 107, 107, 0.2);
  text-shadow: 0 0 10rpx rgba(255, 107, 107, 0.2);
}

.card-badge.text-muted {
  color: #636e72;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.05);
}

.card-icon {
  font-size: 32rpx;
}

.locked-icon {
  color: #2f3542;
  font-weight: bold;
}

.card-body {
  display: flex;
  flex-direction: column;
}

.card-cause {
  font-size: 28rpx;
  font-weight: bold;
  color: #f1f2f6;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.locked-cause {
  color: #57606f;
  letter-spacing: 4rpx;
}

.card-comment {
  font-size: 24rpx;
  color: #a4b0be;
  line-height: 1.6;
  background: rgba(0, 0, 0, 0.15);
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #ff6b6b;
}

.locked-comment {
  font-size: 22rpx;
  color: #57606f;
  line-height: 1.5;
}

/* 底部按钮 */
.action-buttons {
  margin-top: 50rpx;
  display: flex;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.06);
  color: #e0e0e0;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.12);
}

.btn-reset {
  background: rgba(255, 107, 107, 0.05);
  color: #ff6b6b;
  border: 2rpx solid rgba(255, 107, 107, 0.2);
}

.btn-reset:active {
  background: rgba(255, 107, 107, 0.15);
}

/* 动效 */
.animate-pulse {
  animation: pulse-border 3.5s infinite ease-in-out;
}

@keyframes pulse-border {
  0%, 100% {
    border-color: rgba(255, 107, 107, 0.2);
    box-shadow: 0 0 10rpx rgba(255, 107, 107, 0.05);
  }
  50% {
    border-color: rgba(255, 107, 107, 0.4);
    box-shadow: 0 0 25rpx rgba(255, 107, 107, 0.25);
  }
}
